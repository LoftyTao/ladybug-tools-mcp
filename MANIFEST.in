include requirements.in requirements.txt
recursive-include src/ironbug_bridge *.cs *.csproj
recursive-include src/grasshopper_components/user_objects *.ghuser *.json
recursive-include src/grasshopper_components *.py
recursive-include src/web_view/vendor *.js
recursive-include src/pyhygrothermfem_native *
recursive-include vendor/pyHygroThermFEM-Fairyfly *
prune docs
prune tests
prune src/ironbug_bridge/bin
prune src/ironbug_bridge/obj
prune vendor/pyHygroThermFEM-Fairyfly/.git
prune vendor/pyHygroThermFEM-Fairyfly/build
prune vendor/pyHygroThermFEM-Fairyfly/dist
prune vendor/pyHygroThermFEM-Fairyfly/tests
prune vendor/pyHygroThermFEM-Fairyfly/docs
exclude CONTEXT.md
global-exclude AGENTS.md
global-exclude .git
global-exclude _build_source.json
global-exclude _native*.pyd
global-exclude _native*.so
